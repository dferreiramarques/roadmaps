# Copy to .env for local development (or set these as Variables on Railway). Never commit real values.

# Required to enable editing. A long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Signs the admin session cookie. Set it so sessions survive a restart/deploy (another long random string).
SESSION_SECRET=

# Where the roadmaps are stored. On Railway mount a Volume at /data and set DATA_DIR=/data
DATA_DIR=./data

# Port (Railway sets this itself)
PORT=3000
