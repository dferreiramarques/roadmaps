# Copy to .env for local development (or set these as Variables on Railway). Never commit real values.

# Google sign-in (the same kind of OAuth "Web application" client Taskboards uses).
# Authorized redirect URI to add in Google Cloud:  <your site>/auth/callback   e.g. https://roadmaps.example.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the sign-in cookie. A long random string, e.g. (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
COOKIE_SECRET=

# A Google API key (Drive API only) used by the SERVER to read the public copies of shared roadmaps.
# Do not add an HTTP-referrer restriction (the server calls Drive, not a browser).
DRIVE_API_KEY=

# The public address of this site, e.g. https://roadmaps.monco.io. Recommended in production so the
# sign-in redirect, shared page links and embed snippets always use your own domain (otherwise it is
# detected from the request).
PUBLIC_URL=

# Port (Railway sets this itself)
PORT=3000
